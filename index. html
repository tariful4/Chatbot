<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    const firebaseConfig = {
        apiKey: "AIzaSyCOwXc5gc46tz1UjPEqcA993YS62clgV_k",
        authDomain: "tchat-46fdb.firebaseapp.com",
        projectId: "tchat-46fdb",
        storageBucket: "tchat-46fdb.firebasestorage.app",
        messagingSenderId: "223368702559",
        appId: "1:223368702559:web:65b9a708ffb81a861909ea"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    const GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"; // আপনার জেমিনি এপিআই কি এখানে দিন

    const chatBox = document.getElementById("chatBox");
    const userInput = document.getElementById("userInput");

    window.sendMessage = async function() {
        const text = userInput.value.trim();
        if (!text) return;

        appendMessage(text, 'user');
        userInput.value = "";
        
        let botReply = "";

        try {
            // ১. ফায়ারবেস থেকে আগের সব শেখা ডাটা (মেমরি) লোড করা
            const querySnapshot = await getDocs(collection(db, "knowledge_base"));
            let memoryContext = "";
            let foundLocally = false;

            querySnapshot.forEach((doc) => {
                const data = doc.data();
                // যদি ইউজারের কথার সাথে আগের কোনো কথার মিল বা প্যাটার্ন পাওয়া যায়
                if (data.userInput && data.userInput.toLowerCase().includes(text.toLowerCase())) {
                    botReply = data.botResponse;
                    foundLocally = true;
                }
                memoryContext += `User: ${data.userInput} | Bot: ${data.botResponse}\n`;
            });

            // ২. যদি লোকাল মেমরিতে সরাসরি উত্তর না থাকে, তবে জেমিনি এপিআই-এর মাধ্যমে অনলাইন থেকে বুদ্ধিমান উত্তর আনবে
            if (!foundLocally) {
                botReply = await fetchSmartAnswerFromGemini(text, memoryContext);

                // ৩. নতুন শেখা কথাটি বা প্যাটার্নটি ডাটাবেসে সেভ করে রাখা (Self-Learning)
                await addDoc(collection(db, "knowledge_base"), {
                    userInput: text,
                    botResponse: botReply,
                    timestamp: new Date()
                });
            }
        } catch (e) {
            console.error("ত্রুটি ঘটেছে: ", e);
            botReply = "দুঃখিত, এই মুহূর্তে সার্ভারে সংযোগ করতে সমস্যা হচ্ছে।";
        }

        setTimeout(() => {
            appendMessage(botReply, 'bot');
        }, 500);
    }

    // ইউজার সরাসরি না বললেও তার কথার প্যাটার্ন ও মনের ভাব বুঝে উত্তর তৈরি করার ফাংশন
    async function fetchSmartAnswerFromGemini(userMessage, pastMemory) {
        if (GEMINI_API_KEY === "YOUR_GEMINI_API_KEY_HERE") {
            return "অনুগ্রহ করে কোডে আপনার সঠিক Gemini API Key যুক্ত করুন।";
        }

        const systemPrompt = `তুমি একজন অত্যন্ত বুদ্ধিমান এবং সেলফ-লার্নিং এআই চ্যাটবট। ইউজার যদি কোনো কথা ঘুরিয়ে বা সরাসরি না বলে ইশারা-ইঙ্গিতে বা নির্দিষ্ট প্যাটার্নে বলে, তবে তার অন্তর্নিহিত উদ্দেশ্য (Intent) বুঝে অত্যন্ত নিখুঁত ও প্রাকৃতিকভাবে উত্তর দেবে। প্রয়োজনে অনলাইন বা তোমার জ্ঞান ভাণ্ডার থেকে তথ্য নিয়ে উত্তর প্রস্তুত করবে। আগের কথোপকথনের মেমরি: \n${pastMemory}`;

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                contents: [
                    { parts: [{ text: systemPrompt }, { text: userMessage }] }
                ]
            })
        });

        const data = await response.json();
        if (data.candidates && data.candidates[0].content) {
            return data.candidates[0].content.parts[0].text;
        } else {
            return "বিষয়টি বুঝতে পারিনি, দয়াF করে একটু পরিষ্কার করে বলুন।";
        }
    }

    function appendMessage(text, sender) {
        const msgDiv = document.createElement("div");
        const isUser = sender === 'user';
        msgDiv.className = `message ${sender}`;
        msgDiv.innerText = text;
        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    window.handleKeyPress = function(e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
    }
</script>
